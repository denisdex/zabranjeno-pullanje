<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Okidač s Maca: svaka 2 sata pokrene workflow Podaci (GitHubov cron zna preskakati).
     Uključi: cp skripte/eu.kafana.podaci.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/eu.kafana.podaci.plist
     Isključi: launchctl bootout gui/$(id -u)/eu.kafana.podaci -->
<plist version="1.0">
<dict>
  <key>Label</key><string>eu.kafana.podaci</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/denismarijanovic/.local/bin/gh</string>
    <string>workflow</string><string>run</string><string>podaci.yml</string>
    <string>-R</string><string>denisdex/zabranjeno-pullanje</string>
  </array>
  <key>StartInterval</key><integer>7200</integer>
  <key>StandardOutPath</key><string>/tmp/kafana-podaci.log</string>
  <key>StandardErrorPath</key><string>/tmp/kafana-podaci.log</string>
</dict>
</plist>
